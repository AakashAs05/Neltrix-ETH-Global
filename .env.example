GRAPH_API_KEY=
GRAPH_GATEWAY_URL=https://gateway.thegraph.com/api

# Messari "dex-amm" standardized-schema subgraph IDs (decentralized network).
# Same query shape works against every entry here — that's the point.
UNISWAP_V3_ETHEREUM_SUBGRAPH_ID=
SUSHISWAP_ETHEREUM_SUBGRAPH_ID=

# --- Hedera x402 (testnet) ---
# Create free testnet accounts at https://portal.hedera.com/
HEDERA_NETWORK=hedera:testnet
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# Merchant: receives payment for the gated endpoint. Receive-only, no key needed.
HEDERA_MERCHANT_ACCOUNT_ID=

# Agent: the buyer. Signs the transfer, so this one needs a private key.
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=

# Price per paid API call, in tinybars (1 HBAR = 100_000_000 tinybars).
X402_PRICE_TINYBARS=10000000
X402_ASSET=0.0.0
